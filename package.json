    "demo:dua": "node CuocDuaKyThu/server/index.js --mock",
    "check-live": "node scripts/check-live.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@pixiv/three-vrm": "3.5.5",
    "dotenv": "16.6.1",
    "mongodb": "7.8.0",
