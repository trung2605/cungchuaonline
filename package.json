{
  "name": "live-tiktok",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Live TikTok Interactive 3D Games Monorepo (Cúng Chùa Online & Cuộc Đua Kỳ Thú)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/start-all.mjs",
